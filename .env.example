# Copy to .env before starting the Docker stack (make env does this).
# Set a unique JWT_SECRET for anything beyond local experimentation.

CLIENT_ORIGIN=http://localhost:3000
CLIENT_PORT=3000
API_PORT=4000
ADMINER_PORT=8080

JWT_SECRET=change-me-to-a-long-random-value-32chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

DB_USER=auction_user
DB_PASSWORD=auction_password
DB_NAME=auction_system
MYSQL_ROOT_PASSWORD=root_password

MYSQL_HOST_PORT=3306
POSTGRES_HOST_PORT=5433
