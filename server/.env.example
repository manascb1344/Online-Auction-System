# Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database: mysql | postgres
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auction_user
DB_PASSWORD=auction_password
DB_NAME=auction_system

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
