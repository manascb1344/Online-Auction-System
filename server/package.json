{
  "name": "auction-server",
  "version": "2.0.0",
  "private": true,
  "description": "Dual-database REST API for the Online Auction System",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/compile.test.js test/api.test.js",
    "lint": "eslint src test scripts",
    "db:seed:hosted": "node scripts/seed-hosted.js",
    "db:demo-topup": "node scripts/top-up-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.13.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
